# NORQVA Intelligence — Backend Test Environment Variables Example
# Matches .github/workflows/staging-pipeline.yml CI specification.
# Copy to .env.test or pass to test runner when testing against dedicated PostgreSQL.

NODE_ENV=test
ALLOW_DESTRUCTIVE_TESTS=true
AUTH_MODE=real
DATABASE_URL_TEST=postgresql://postgres:test_password@localhost:5432/norqva_test
SUPABASE_URL=https://mock.supabase.co
SUPABASE_JWKS_URL=https://mock.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_PUBLISHABLE_KEY=sb_pub_mock
ASAAS_API_KEY=MOCK
ASAAS_BASE_URL=https://api-sandbox.asaas.com/v3
ASAAS_ENV=sandbox
ASAAS_WEBHOOK_AUTH_TOKEN=test_token
CPF_CNPJ_HASH_SECRET=test_cpf_cnpj_hash_secret_32_characters_minimum
PORT=5000
