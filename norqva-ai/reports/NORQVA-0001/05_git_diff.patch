+ALTER TABLE opportunity_scores
+  ADD COLUMN IF NOT EXISTS is_simulated BOOLEAN NOT NULL DEFAULT TRUE,
+  ADD COLUMN IF NOT EXISTS ai_provider VARCHAR(50) DEFAULT 'MOCK';
